{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Session Key Importer",
  "version": "0.1.0",
  "identifier": "com.gexinggexing.claude-session-key-importer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
